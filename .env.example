# Copy to .env and fill in what you use. Never commit the real file.
# .env is gitignored and force-added env files are encrypted by git-crypt
# (see .gitattributes). Keep this template free of real values.

# Default model when no explicit id is passed.
FOLIO_AI_MODEL=deepseek-chat

# Enables deepseek-chat and deepseek-reasoner.
DEEPSEEK_API_KEY=

# Enables gpt-4o-mini.
OPENAI_API_KEY=

# Optional: API port when running a single built server.
# PORT=43126
